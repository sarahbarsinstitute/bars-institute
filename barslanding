              <span class="metric-value">$231,759</span>
            </div>

            <div class="metric-row">
              <span class="metric-label">Gain in 80% of scenarios</span>
              <span class="metric-value">$31,901 – $402,496</span>
            </div>

            <div class="metric-row">
              <span class="metric-label">Behind in</span>
              <span class="metric-value">6.7% of scenarios</span>
            </div>

            <div class="metric-row">
              <span class="metric-label">Worst case, if behind</span>
              <span class="metric-value">−$180,103</span>
            </div>

            <div class="metric-row">
              <span class="metric-label">Load-bearing assumption</span>
              <span class="metric-value">Volume loss</span>
            </div>

            <div class="metric-row">
